# Copy to env.sh (git-ignored) and edit. Sourced by every script in scripts/.

# terraform or tofu
export TF_BIN="terraform"

# Fleet repository (tpg-fleet) that Argo CD reads and Argo Workflows pushes to
export FLEET_REPO_URL="https://github.com/<org>/tpg-fleet.git"
export FLEET_REPO_REVISION="main"
# Local clone of tpg-fleet, used by the register and bootstrap steps
export FLEET_LOCAL_DIR="${HOME}/src/tpg-fleet"

export GITHUB_USER="<github-username>"
export BROADCOM_USER="<broadcom-support-portal-user>"

# Monitoring option applied by the bootstrap step: none | azure | standalone
export MONITORING_OPTION="none"

# Pinned Helm chart versions for the hub
export ARGOCD_CHART_VERSION="10.9.1"
export ARGO_WORKFLOWS_CHART_VERSION="2.0.6"

# Secrets: export these in your shell before the hub-secrets step, or the
# script prompts for them. Never write them into this file.
#   export BROADCOM_TOKEN=...
#   export GIT_READ_PAT=...           (fine-grained PAT, Contents: Read-only)
#   export GIT_PUSH_PAT=...           (fine-grained PAT, Contents: Read and write; Pull requests: Read and write for pushMode=pr)
#   export BACKUP_STORAGE_KEY=...     (optional; overrides backup.keySource)
#   export ARGOCD_ADMIN_PASSWORD=...  (existing hub without argocd-initial-admin-secret)
#   export GRAFANA_ADMIN_PASSWORD=... (standalone monitoring; generated when not set)
#   export VAULT_TOKEN=...            (optional Vault token with the tpg-admin policy; by default the
#                                      scripts log in through the Kubernetes auth role tpg-setup)
#   export GIT_ADMIN_PAT=...          (jumpbox fleet repository only, scripts/jumpbox/push-fleet-repo.sh:
#                                      creates the repository; classic PAT with scope repo, or
#                                      fine-grained with Administration: Read and write and
#                                      Contents: Read and write)
# The hub-secrets step checks the tokens before storing them in Vault:
#   Broadcom: helm registry login; GitHub: both PATs active, repository access, push
#   (git push --dry-run) and pull request read. Set VALIDATE_PR_WRITE=true to also open
#   and close a test pull request with the read/write PAT (proves Pull requests: write).
# export VALIDATE_PR_WRITE="false"

# Helm releases that are already installed (hub: argocd, argo-workflows, vault, kps;
# targets: cert-manager, kps, tpg-ksm, VSO): ask (default on a terminal), upgrade,
# skip (default without a terminal) or abort. run.sh --yes sets upgrade.
# export ADDONS_EXISTING="ask"

# Retries of kubectl, helm, az and argocd calls that fail with a transient API or
# network error (timeouts, connection resets, 429/502/503/504): attempts in total,
# and the first wait in seconds (doubled each time: 5, 10, 20, 40).
# export TPG_RETRY_ATTEMPTS="5"
# export TPG_RETRY_DELAY="5"

# Standalone monitoring: how long the addons step waits for a target's metrics to
# reach the hub Prometheus before it reports MONITORING_NOT_FLOWING.
# export MONITORING_FLOW_TIMEOUT="300"

# Standalone monitoring: extra values files for the hub kps release, relative to tpg-fleet
# export KPS_HUB_EXTRA_VALUES="monitoring/grafana/smtp/grafana-smtp-values.yaml"

# GitHub API for pushMode=pr (GitHub Enterprise: https://<host>/api/v3)
export GITHUB_API_URL="https://api.github.com"

# Vault keys file of run.sh --save-vault-recovery-keys: the 5 unseal (shamir) or
# recovery (azure-keyvault) keys of the first vault operator init, mode 600, in a
# directory of mode 700. Never the root token. An existing file is kept; the new
# keys then go to <file>.<UTC time>. Copy the file off the machine and delete it.
export VAULT_RECOVERY_KEYS_FILE="${HOME}/.tpg/vault-keys.txt"

# Inventory written by Terraform instead of read from terraform output (the
# jumpbox, where Terraform uploads .work/inventory.yaml; env.jumpbox.sh sets it).
# export INVENTORY_PREBUILT="false"

# Jumpbox fleet repository (scripts/jumpbox/push-fleet-repo.sh; Terraform
# create_fleet_repo sets both in env.jumpbox.sh from fleet_repo_validate and
# fleet_repo_force): run scripts/validate.sh (which includes tests/run-all.sh)
# before the push, and replace a branch that holds other content (git push --force).
# Both are OFF by default and need two switches (Round 20): the Terraform
# variable (fleet_repo_validate / fleet_repo_force = true) AND env.sh. In env.sh
# either spelling works; if both are set, both must be true. Uncomment to enable:
# export FLEET_VALIDATE="true"            # or: export fleet_repo_validate="true"
# export FLEET_REPO_FORCE="true"          # or: export fleet_repo_force="true"

# On the jumpbox, Terraform writes env.jumpbox.sh next to this file with the
# jumpbox values (FLEET_REPO_URL, FLEET_LOCAL_DIR, INVENTORY_PREBUILT,
# VAULT_RECOVERY_KEYS_FILE). scripts/lib/common.sh reads it after this file, so
# its values win; in an interactive shell: source env.sh; source env.jumpbox.sh
