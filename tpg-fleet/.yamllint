extends: default
rules:
  line-length: disable
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  indentation:
    indent-sequences: whatever
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
ignore: |
  helm_artifacts/instance/tpg-instance/templates/
  helm_artifacts/instance/crd-reference/templates/
